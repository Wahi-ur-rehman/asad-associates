<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 340 56" width="340" height="56" fill="none">
  <defs>
    <linearGradient id="markWaterLight" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8" />
      <stop offset="100%" stop-color="#0284C7" />
    </linearGradient>
    <linearGradient id="markLeafLight" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#059669" />
      <stop offset="100%" stop-color="#34D399" />
    </linearGradient>
    <linearGradient id="markStoneLight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#E2D4BC" />
    </linearGradient>
  </defs>

  <!-- Left Icon Emblem (52x52 scaled inside 56 height) -->
  <g transform="translate(2, 2) scale(0.81)">
    <!-- Hexagonal Frame -->
    <path d="M32 3 L58 18 L58 46 L32 61 L6 46 L6 18 Z" stroke="url(#markStoneLight)" stroke-width="1.4" stroke-opacity="0.3" fill="#0F1210" fill-opacity="0.8" />
    <!-- Architectural "A" Monogram -->
    <path d="M32 9 L15 51 L22 51 L32 24 L42 51 L49 51 Z" fill="url(#markStoneLight)" />
    <!-- Flowing Water Curve -->
    <path d="M22 36 C27 31, 35 31, 42 36 C39 40, 26 40, 22 36 Z" fill="url(#markWaterLight)" />
    <!-- Leaf / Water Surge Crest -->
    <path d="M32 17 C35 24, 43 27, 49 25 C45 32, 36 30, 32 17 Z" fill="url(#markLeafLight)" />
    <circle cx="32" cy="14" r="2.2" fill="#38BDF8" />
  </g>

  <!-- Typography: Luxury Architectural Brand Identity -->
  <g transform="translate(60, 0)">
    <!-- Main Headline: ASAD ASSOCIATES -->
    <text x="0" y="27" font-family="'Cormorant Garamond', 'Playfair Display', Georgia, serif" font-size="22" font-weight="600" letter-spacing="0.14em" fill="#FAF8F3">
      ASAD ASSOCIATES
    </text>

    <!-- Subtitle: Category & Heritage -->
    <text x="1" y="44" font-family="'Sora', 'General Sans', system-ui, sans-serif" font-size="8.5" font-weight="500" letter-spacing="0.26em" fill="#C2D4D0">
      WATER ARCHITECTURE &amp; ENGINEERING
    </text>

    <!-- Small Heritage Indicator -->
    <text x="210" y="44" font-family="'Sora', monospace" font-size="8" font-weight="600" letter-spacing="0.15em" fill="#FF4D1A">
      • EST. 1998
    </text>
  </g>
</svg>
